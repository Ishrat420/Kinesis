{
  "name": "kinesis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-extraction-assets.mjs && next dev",
    "build": "prisma generate && node scripts/copy-extraction-assets.mjs && next build",
    "db:deploy": "node scripts/deploy-database.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest --config vitest.config.mts",
    "test:run": "vitest run --config vitest.config.mts",
    "test:integration": "vitest --config vitest.integration.config.mts",
    "test:integration:run": "vitest run --config vitest.integration.config.mts",
    "test:db:reset": "node scripts/reset-test-database.mjs",
    "owner:rebind": "node scripts/rebind-owner.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.2",
    "@prisma/client": "^6.19.3",
    "@tesseract.js-data/eng": "1.0.0",
    "chrono-node": "2.10.3",
    "lucide-react": "^1.46.0",
    "mrz": "5.0.2",
    "next": "16.3.8",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.22.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
