generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  firstName           String
  lastName            String
  preferredName       String?
  email               String
  clerkUserId         String?              @unique
  settings            UserSettings?
  financeItems        FinanceItem[]
  documents           Document[]
  notifications       Notification[]
  documentTypes       DocumentType[]
  goals               Goal[]
  people              Person[]
  relationships       Relationship[]
  goalUnits           GoalUnit[]
  customModules       CustomModule[]
  dismissals          AttentionDismissal[]
  activityEvents      ActivityEvent[]
  securityEvents      SecurityEvent[]
  objects             Object[]
  objectRelationships ObjectRelationship[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model UserSettings {
  id                   String   @id @default(uuid())
  appearance           String   @default("system")
  locale               String   @default("en-AU")
  currency             String   @default("AUD")
  notificationsEnabled Boolean  @default(true)
  remindersEnabled     Boolean  @default(true)
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model FinanceItem {
  id        String    @id
  kind      String
  name      String
  amount    Float
  category  String?
  rate      Float?
  frequency String?
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId  String    @unique
  object    Object    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, kind, name])
}

model Document {
  id                  String          @id
  name                String
  type                String
  status              String
  expiryDate          DateTime?
  issueDate           DateTime?
  owner               String
  documentNumber      String?
  country             String?
  notes               String?
  link                String?
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId            String          @unique
  object              Object          @relation(fields: [objectId], references: [id], onDelete: Cascade)
  prompt              Int             @default(180)
  expiryDateLabel     String          @default("Expiry date")
  issueDateLabel      String          @default("Issue date")
  documentNumberLabel String          @default("Document number")
  countryLabel        String          @default("Country")
  notesLabel          String          @default("Notes")
  linkLabel           String          @default("Link")
  customFields        DocumentField[]
  notifications       Notification[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

enum NotificationType {
  REMINDER_DUE
  EXPIRED
  MILESTONE_DUE
}

model Notification {
  id              String           @id
  type            NotificationType
  documentId      String?
  milestoneId     String?
  reminderAt      DateTime?
  timeUntilExpiry String?
  expiryDate      DateTime?
  documentName    String
  documentType    String?
  message         String
  actionUrl       String
  readAt          DateTime?
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  document        Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  milestone       Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId, type, expiryDate])
  @@unique([userId, milestoneId, type, expiryDate])
  @@index([userId, createdAt])
  @@index([milestoneId])
}

model DocumentField {
  id         String             @id
  documentId String
  label      String
  value      String
  type       CustomFieldType    @default(TEXT)
  targetType KinesisObjectType?
  targetId   String?
  position   Int                @default(0)
  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, position])
  @@index([targetType, targetId])
}

model DocumentType {
  id        String   @id
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Goal {
  id                    String               @id
  name                  String
  targetDate            DateTime?
  note                  String?
  status                String               @default("Active")
  targetValue           Float?
  currentValue          Float?
  unit                  String?
  showMilestoneProgress Boolean              @default(true)
  showTargetProgress    Boolean              @default(true)
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId              String               @unique
  object                Object               @relation(fields: [objectId], references: [id], onDelete: Cascade)
  milestones            Milestone[]
  metricHistory         GoalMetricSnapshot[]
  relationshipLinks     RelationshipGoal[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

enum ObjectRelationshipType {
  SUPPORTS
  BLOCKS
  DEPENDS_ON
  RELATES_TO
  ALONGSIDE
}

model Object {
  id                    String               @id @default(uuid())
  type                  KinesisObjectType
  name                  String
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  document              Document?
  goal                  Goal?
  financeItem           FinanceItem?
  person                Person?
  customItem            CustomItem?
  outgoingRelationships ObjectRelationship[] @relation("RelationshipSource")
  incomingRelationships ObjectRelationship[] @relation("RelationshipTarget")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([userId, type, name])
}

model ObjectRelationship {
  id             String                 @id @default(uuid())
  sourceObjectId String
  targetObjectId String
  sourceObject   Object                 @relation("RelationshipSource", fields: [sourceObjectId], references: [id], onDelete: Cascade)
  targetObject   Object                 @relation("RelationshipTarget", fields: [targetObjectId], references: [id], onDelete: Cascade)
  type           ObjectRelationshipType
  pairKey        String
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, pairKey])
  @@index([userId, sourceObjectId])
  @@index([userId, targetObjectId])
}

model Person {
  id                    String                      @id
  name                  String
  category              String?
  icon                  String                      @default("user")
  color                 String                      @default("#292524")
  bubbleSize            Int                         @default(84)
  positionX             Float                       @default(0)
  positionY             Float                       @default(0)
  isSelf                Boolean                     @default(false)
  selfNotes             String?
  userId                String
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId              String                      @unique
  object                Object                      @relation(fields: [objectId], references: [id], onDelete: Cascade)
  relationshipsAsFirst  Relationship[]              @relation("RelationshipFirstPerson")
  relationshipsAsSecond Relationship[]              @relation("RelationshipSecondPerson")
  selfPractices         ConnectionPractice[]
  selfReflections       RelationshipReflection[]
  selfImportantDates    RelationshipImportantDate[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
}

model Relationship {
  id             String                      @id
  firstPersonId  String
  secondPersonId String
  type           String?
  notes          String?
  userId         String
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstPerson    Person                      @relation("RelationshipFirstPerson", fields: [firstPersonId], references: [id], onDelete: Cascade)
  secondPerson   Person                      @relation("RelationshipSecondPerson", fields: [secondPersonId], references: [id], onDelete: Cascade)
  practices      ConnectionPractice[]
  reflections    RelationshipReflection[]
  importantDates RelationshipImportantDate[]
  linkedGoals    RelationshipGoal[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([userId, firstPersonId, secondPersonId])
  @@index([firstPersonId])
  @@index([secondPersonId])
}

model ConnectionPractice {
  id             String        @id
  relationshipId String?
  selfPersonId   String?
  title          String
  cadence        String?
  position       Int           @default(0)
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  selfPerson     Person?       @relation(fields: [selfPersonId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([relationshipId, position])
  @@index([selfPersonId, position])
}

model RelationshipReflection {
  id             String        @id
  relationshipId String?
  selfPersonId   String?
  text           String
  reflectedAt    DateTime
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  selfPerson     Person?       @relation(fields: [selfPersonId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([relationshipId, reflectedAt])
  @@index([selfPersonId, reflectedAt])
}

model RelationshipImportantDate {
  id             String        @id
  relationshipId String?
  selfPersonId   String?
  label          String
  date           DateTime
  repeatsYearly  Boolean       @default(false)
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  selfPerson     Person?       @relation(fields: [selfPersonId], references: [id], onDelete: Cascade)

  @@index([relationshipId, date])
  @@index([selfPersonId, date])
}

model RelationshipGoal {
  relationshipId String
  goalId         String
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  goal           Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([relationshipId, goalId])
  @@index([goalId])
}

model GoalMetricSnapshot {
  id         String   @id
  goalId     String
  value      Float
  recordedAt DateTime @default(now())
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, recordedAt])
}

model Milestone {
  id            String         @id
  goalId        String
  name          String
  value         Float?
  dueDate       DateTime?
  completed     Boolean        @default(false)
  completedAt   DateTime?
  autoCompleted Boolean        @default(false)
  position      Int            @default(0)
  goal          Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([goalId, position])
}

model GoalUnit {
  id        String   @id
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model CustomModule {
  id             String       @id
  name           String
  normalizedName String
  icon           String
  color          String
  description    String?
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CustomItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, normalizedName])
}

model CustomItem {
  id        String            @id
  moduleId  String
  name      String
  notes     String?
  reminder  DateTime?
  link      String?
  archived  Boolean           @default(false)
  module    CustomModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  objectId  String            @unique
  object    Object            @relation(fields: [objectId], references: [id], onDelete: Cascade)
  fields    CustomItemField[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([moduleId, archived, createdAt])
}

model CustomItemField {
  id         String             @id
  itemId     String
  label      String
  value      String
  type       CustomFieldType    @default(TEXT)
  targetType KinesisObjectType?
  targetId   String?
  position   Int                @default(0)
  item       CustomItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
  @@index([targetType, targetId])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  CHECKBOX
  LINK
  KINESIS_LINK
}

enum KinesisObjectType {
  DOCUMENT
  CUSTOM_ITEM
  GOAL
  FINANCE_ITEM
  PERSON
}

model AttentionDismissal {
  id        String   @id
  itemKey   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemKey])
}

model ActivityEvent {
  id         String   @id
  action     String
  moduleName String
  objectName String
  icon       String
  href       String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  event     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
