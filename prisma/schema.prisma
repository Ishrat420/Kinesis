generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  firstName           String
  lastName            String
  preferredName       String?
  email               String
  clerkUserId         String?              @unique
  settings            UserSettings?
  financeItems        FinanceItem[]
  documents           Document[]
  notificationReads   NotificationRead[]
  documentTypes       DocumentType[]
  goals               Goal[]
  people              Person[]
  relationships       Relationship[]
  goalUnits           GoalUnit[]
  customModules       CustomModule[]
  templates           Template[]
  dismissals          AttentionDismissal[]
  activityEvents      ActivityEvent[]
  securityEvents      SecurityEvent[]
  objects             Object[]
  objectRelationships ObjectRelationship[]
  todos               Todo[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model UserSettings {
  id                           String   @id @default(uuid())
  appearance                   String   @default("system")
  locale                       String   @default("en-AU")
  currency                     String   @default("AUD")
  notificationsEnabled         Boolean  @default(true)
  remindersEnabled             Boolean  @default(true)
  // How many days before a due date each object type's reminder window opens.
  // Named per object type so later objects (documents already have their own
  // per-record setting; todos, ...) can each get a column of their own without
  // disturbing the others -- see lib/reminders/policy.ts.
  // Decides which day "today" is, and nothing else -- dates are stored and
  // rendered in UTC either side of it. See lib/format/preferences.ts.
  timeZone                     String   @default("Australia/Sydney")
  milestoneReminderLeadDays    Int      @default(30)
  relationshipReminderLeadDays Int      @default(30)
  customItemReminderLeadDays   Int      @default(30)
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model FinanceItem {
  id        String    @id
  kind      String
  name      String
  amount    Float
  category  String?
  rate      Float?
  frequency String?
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId  String    @unique
  object    Object    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, kind, name])
}

model Document {
  id                  String               @id
  name                String
  type                String
  status              String
  expiryDate          DateTime?
  issueDate           DateTime?
  owner               String
  documentNumber      String?
  country             String?
  notes               String?
  link                String?
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId            String               @unique
  object              Object               @relation(fields: [objectId], references: [id], onDelete: Cascade)
  // Takes the document out of the reminder cycle without deleting it, the way
  // CustomItem.archived does. A document otherwise has no terminal state at
  // all -- `status` above is derived display data that nothing filters on, so
  // the only exits were clearing the expiry date or deleting the record.
  archived            Boolean              @default(false)
  prompt              Int                  @default(180)
  expiryDateLabel     String               @default("Expiry date")
  issueDateLabel      String               @default("Issue date")
  documentNumberLabel String               @default("Document number")
  countryLabel        String               @default("Country")
  notesLabel          String               @default("Notes")
  linkLabel           String               @default("Link")
  notificationReads   NotificationRead[]
  dismissals          AttentionDismissal[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId, archived])
}

enum NotificationType {
  REMINDER_DUE
  EXPIRED
  MILESTONE_DUE
  CUSTOM_ITEM_DUE
  TODO_DUE
}

/**
 * A record's custom fields, keyed on the `Object` identity every record
 * already carries -- Document and CustomItem used to each keep their own,
 * structurally identical field table (DocumentField, CustomItemField), which
 * is what made a Kinesis Link, a date field, or a type-immutability check a
 * thing implemented twice. One table now serves every field-capable record;
 * which record it belongs to is read off `object.type`, not off which table
 * the row lives in. See the 20260915000000 migration for how the two old
 * tables' rows were folded in without losing an id.
 */
model ObjectField {
  id              String          @id
  objectId        String
  object          Object          @relation(fields: [objectId], references: [id], onDelete: Cascade)
  label           String
  value           String
  type            CustomFieldType @default(TEXT)
  position        Int             @default(0)
  links           FieldLink[]
  // Set when this row is a *value* for a template field (KD-035 Phase 2/3)
  // rather than an ad-hoc extra -- label/type are unused for such a row and
  // read from the joined TemplateField instead, never duplicated onto this
  // one. Restrict: see the comment on TemplateField.objectFields.
  templateFieldId String?
  templateField   TemplateField?  @relation(fields: [templateFieldId], references: [id], onDelete: Restrict)

  @@index([objectId, position])
  @@index([templateFieldId])
}

/**
 * One target of a Kinesis Link field (KD-034). A field used to hold at most
 * one target, as a nullable column on `ObjectField` itself; a field now holds
 * as many as the person adds, each its own row here, ordered the way they
 * added them. Cascades on both ends: deleting the field takes its links with
 * it, and deleting the target object removes just that token rather than
 * leaving the field behind with an empty slot to explain -- there is no
 * "field pointing at nothing" state for a multi-valued field to be in.
 */
model FieldLink {
  id             String      @id
  fieldId        String
  field          ObjectField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  targetObjectId String
  targetObject   Object      @relation("FieldLinkTarget", fields: [targetObjectId], references: [id], onDelete: Cascade)
  position       Int         @default(0)

  @@index([fieldId, position])
  @@index([targetObjectId])
}

model DocumentType {
  id        String   @id
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Goal {
  id                    String               @id
  name                  String
  targetDate            DateTime?
  note                  String?
  status                String               @default("Active")
  targetValue           Float?
  currentValue          Float?
  unit                  String?
  showMilestoneProgress Boolean              @default(true)
  showTargetProgress    Boolean              @default(true)
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId              String               @unique
  object                Object               @relation(fields: [objectId], references: [id], onDelete: Cascade)
  milestones            Milestone[]
  metricHistory         GoalMetricSnapshot[]
  relationshipLinks     RelationshipGoal[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([userId, status])
}

enum ObjectRelationshipType {
  SUPPORTS
  BLOCKS
  DEPENDS_ON
  RELATES_TO
  ALONGSIDE
}

model Object {
  id   String            @id @default(uuid())
  type KinesisObjectType
  /// Maintained by database triggers from the typed record's own name; never
  /// write it directly. See 20260902000000_object_capability_layer.
  name String

  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  document              Document?
  goal                  Goal?
  financeItem           FinanceItem?
  person                Person?
  customItem            CustomItem?
  todo                  Todo?
  outgoingRelationships ObjectRelationship[] @relation("RelationshipSource")
  incomingRelationships ObjectRelationship[] @relation("RelationshipTarget")
  fields                ObjectField[]
  linkedFromFieldLinks  FieldLink[]          @relation("FieldLinkTarget")
  // The template this object was created under, if any (KD-035 Phase 2) --
  // set once, at creation, never changed automatically (Decision 7). This is
  // the permanent fact this object reads its template's live field list
  // from, independent of whatever CustomModule.templateId says today; it is
  // also the single fact Template deletion is gated on (Decision 7's one
  // gate), which is why this relation restricts rather than cascades or
  // nulls -- an object must never silently lose the template it's rendering
  // its fields from.
  templateId            String?
  template              Template?            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdAt             DateTime             @default(now())

  @@index([userId, type, name])
  @@index([templateId])
}

model ObjectRelationship {
  id             String                 @id @default(uuid())
  sourceObjectId String
  targetObjectId String
  sourceObject   Object                 @relation("RelationshipSource", fields: [sourceObjectId], references: [id], onDelete: Cascade)
  targetObject   Object                 @relation("RelationshipTarget", fields: [targetObjectId], references: [id], onDelete: Cascade)
  type           ObjectRelationshipType
  pairKey        String
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, pairKey])
  @@index([userId, sourceObjectId])
  @@index([userId, targetObjectId])
}

model Person {
  id                    String                      @id
  name                  String
  category              String?
  icon                  String                      @default("user")
  color                 String                      @default("#292524")
  bubbleSize            Int                         @default(84)
  positionX             Float                       @default(0)
  positionY             Float                       @default(0)
  isSelf                Boolean                     @default(false)
  selfNotes             String?
  userId                String
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId              String                      @unique
  object                Object                      @relation(fields: [objectId], references: [id], onDelete: Cascade)
  relationshipsAsFirst  Relationship[]              @relation("RelationshipFirstPerson")
  relationshipsAsSecond Relationship[]              @relation("RelationshipSecondPerson")
  selfPractices         ConnectionPractice[]
  selfReflections       RelationshipReflection[]
  selfImportantDates    RelationshipImportantDate[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
}

model Relationship {
  id             String                      @id
  firstPersonId  String
  secondPersonId String
  type           String?
  notes          String?
  userId         String
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstPerson    Person                      @relation("RelationshipFirstPerson", fields: [firstPersonId], references: [id], onDelete: Cascade)
  secondPerson   Person                      @relation("RelationshipSecondPerson", fields: [secondPersonId], references: [id], onDelete: Cascade)
  practices      ConnectionPractice[]
  reflections    RelationshipReflection[]
  importantDates RelationshipImportantDate[]
  linkedGoals    RelationshipGoal[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([userId, firstPersonId, secondPersonId])
  @@index([firstPersonId])
  @@index([secondPersonId])
}

model ConnectionPractice {
  id             String        @id
  relationshipId String?
  selfPersonId   String?
  title          String
  cadence        String?
  // The date the recurrence is measured from, and the day-of-week/day-of-month
  // it lands on. This used to be implied by `createdAt`, which meant a practice
  // silently changed its schedule every time the row was rewritten. It is
  // nullable only so rows predating the column keep working: readers fall back
  // to `createdAt` through `practiceAnchor`, and every write sets it.
  anchorDate     DateTime?
  position       Int           @default(0)
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  selfPerson     Person?       @relation(fields: [selfPersonId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([relationshipId, position])
  @@index([selfPersonId, position])
}

model RelationshipReflection {
  id             String        @id
  relationshipId String?
  selfPersonId   String?
  text           String
  reflectedAt    DateTime
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  selfPerson     Person?       @relation(fields: [selfPersonId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([relationshipId, reflectedAt])
  @@index([selfPersonId, reflectedAt])
}

model RelationshipImportantDate {
  id             String         @id
  relationshipId String?
  selfPersonId   String?
  label          String
  date           DateTime
  repeatsYearly  Boolean        @default(false)
  relationship   Relationship?  @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  selfPerson     Person?        @relation(fields: [selfPersonId], references: [id], onDelete: Cascade)
  notificationReads NotificationRead[]

  @@index([relationshipId, date])
  @@index([selfPersonId, date])
}

model RelationshipGoal {
  relationshipId String
  goalId         String
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  goal           Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([relationshipId, goalId])
  @@index([goalId])
}

model GoalMetricSnapshot {
  id         String   @id
  goalId     String
  value      Float
  recordedAt DateTime @default(now())
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, recordedAt])
}

model Milestone {
  id            String         @id
  goalId        String
  name          String
  value         Float?
  dueDate       DateTime?
  completed     Boolean        @default(false)
  completedAt   DateTime?
  autoCompleted Boolean        @default(false)
  position      Int            @default(0)
  goal          Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  notificationReads NotificationRead[]

  @@index([goalId, position])
}

model GoalUnit {
  id        String   @id
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model CustomModule {
  id             String       @id
  name           String
  normalizedName String
  icon           String
  color          String
  description    String?
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CustomItem[]
  // What a *new* item in this module starts from (KD-035 Phase 2) -- forward-
  // looking only, per Decision 7: never touches an item that already exists,
  // and can be changed or cleared at any time with no precondition. SetNull
  // rather than Restrict, unlike Object.templateId below: deleting a template
  // a module merely starts new items from (with none yet existing under it)
  // is safe, and should just clear the module's pointer rather than be blocked
  // by a link nothing has used yet.
  templateId     String?
  template       Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, normalizedName])
  @@index([templateId])
}

model CustomItem {
  id            String               @id
  moduleId      String
  name          String
  notes         String?
  // What this item is due, if anything -- named for what it functionally is,
  // not "reminder": Needs Attention, the notification engine, Upcoming & Due
  // and the Calendar all treat it as a due date, not a bare alert time.
  dueDate       DateTime?
  link          String?
  archived      Boolean              @default(false)
  module        CustomModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  objectId      String               @unique
  object        Object               @relation(fields: [objectId], references: [id], onDelete: Cascade)
  notificationReads NotificationRead[]
  dismissals    AttentionDismissal[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([moduleId, archived, createdAt])
}

/**
 * A reusable, named set of field definitions (KD-035). A module may start new
 * objects from one (a later migration adds that link); an object that does
 * keeps a permanent pointer to it and reads its field list live -- see
 * TemplateField below. Phase 1: templates are fully manageable from Settings,
 * but nothing else in the app references one yet.
 */
model Template {
  id            String          @id
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  fields        TemplateField[]
  // Every module currently starting new items from this template, and every
  // object that ever has (KD-035 Phase 2). Two different questions -- see the
  // field comments on CustomModule.templateId and Object.templateId.
  customModules CustomModule[]
  objects       Object[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
}

/**
 * One field definition on a Template. `label`, `type`, and `position` live
 * only here -- an object following this template never gets its own copy of
 * them, so renaming, reordering, or adding a field reaches every object
 * instantly, with nothing to backfill (KD-035 Decision 1/7). A field's `id`
 * stays stable across edits: a later migration has objects store values
 * against it directly, so renaming or reordering a field must never give it
 * a new identity.
 */
model TemplateField {
  id           String          @id
  templateId   String
  template     Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label        String
  type         CustomFieldType @default(TEXT)
  position     Int             @default(0)
  // Marks this row as the template's one Due Date field (KD-038, ADR-011) --
  // a distinct kind of field, not a property an ordinary DATE field can gain
  // or lose: there is no UI path that sets this on a row after it's created,
  // and `updateTemplate` refuses a save that tries. Its value is never
  // stored on ObjectField at all -- it writes straight to CustomItem.dueDate
  // (lib/data/custom-modules.ts) -- so, unlike an ordinary field, this one
  // is never actually removable while any object still exists under a
  // template that has it (Object.templateId's Restrict already prevents
  // that object's template from being deleted, and the due-date field is
  // exactly as load-bearing to that object as the template it belongs to).
  // A partial unique index (at most one per template) and a check
  // constraint (only ever true on a DATE row) live in the migration SQL --
  // Prisma schema syntax can't express either directly.
  isDueDate    Boolean         @default(false)
  // Every stored value for this field, across every object that has one
  // (KD-035 Phase 2/3). Restrict, not Cascade or SetNull: a field can only be
  // removed once no object uses its template at all (Decision 7's single
  // gate), so in practice this row is never referenced by the time it's
  // deletable -- this is a backstop against that invariant ever being wrong,
  // not a path this app is meant to exercise. Never populated for a
  // due-date row -- see `isDueDate` above.
  objectFields ObjectField[]

  @@index([templateId, position])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  CHECKBOX
  LINK
  KINESIS_LINK
}

enum KinesisObjectType {
  DOCUMENT
  CUSTOM_ITEM
  GOAL
  FINANCE_ITEM
  PERSON
  TODO
}

enum TodoStatus {
  TODO
  WAITING
  DONE
}

/// A standalone action the user wants to record before deciding where it belongs
/// (ADR-009). It is an Object-backed record like every other module's, so it can
/// be linked to a Document, Goal, Person or Finance Item through the shared
/// ObjectRelationship layer rather than carrying a foreign key of its own.
///
/// `name` rather than `title`: Object.name is projected from this column by the
/// kinesis_sync_object_name trigger, which reads NEW."name" for every model.
model Todo {
  id          String     @id
  name        String
  status      TodoStatus @default(TODO)
  dueDate     DateTime?
  completedAt DateTime?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId    String     @unique
  object      Object     @relation(fields: [objectId], references: [id], onDelete: Cascade)

  notificationReads NotificationRead[]
  dismissals    AttentionDismissal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, dueDate])
}

/**
 * Which derived notifications the owner has already read.
 *
 * Notifications themselves are not stored. They are a pure function of the
 * records, the day, and the reminder settings -- exactly as Needs Attention
 * already is -- so materialising them only created a second copy that had to be
 * kept in step, and a rewrite of every row on every page render to do it. This
 * holds the one fact that cannot be derived.
 */
model NotificationRead {
  id                 String                     @id
  // The notification *as it stood when it was read*:
  // "<kind>:<id>:<type>:<yyyy-mm-dd>". The deadline and the type are both part
  // of the identity, matching the unique constraints the old table carried: a
  // reminder and the overdue notice that follows it are different things to
  // have read, and a moved deadline is a new notification rather than one
  // already seen. Renaming the record it points at changes nothing, which the
  // old table got wrong. See lib/notifications/identity.ts.
  itemKey            String
  // One of these is set, naming the record the key points at. They exist for
  // referential integrity alone -- deleting the record takes its read markers
  // with it, rather than leaving rows nothing can ever match or clean up.
  documentId         String?
  milestoneId        String?
  relationshipDateId String?
  customItemId       String?
  todoId             String?
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  document           Document?                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  milestone          Milestone?                 @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  relationshipDate   RelationshipImportantDate? @relation(fields: [relationshipDateId], references: [id], onDelete: Cascade)
  customItem         CustomItem?                @relation(fields: [customItemId], references: [id], onDelete: Cascade)
  todo               Todo?                      @relation(fields: [todoId], references: [id], onDelete: Cascade)
  readAt             DateTime                   @default(now())

  @@unique([userId, itemKey])
  @@index([documentId])
  @@index([milestoneId])
  @@index([relationshipDateId])
  @@index([customItemId])
  @@index([todoId])
}

model AttentionDismissal {
  id           String      @id
  // The item *and* the deadline it was dismissed at: "<kind>:<id>:<yyyy-mm-dd>".
  // A dismissal is permanent for as long as that deadline stands; editing the
  // date changes the key, so the old row stops matching and the item returns to
  // Needs Attention on its own. See lib/attention/dismissal.ts.
  itemKey      String
  // One of these is set, naming the record the key points at. They exist for
  // referential integrity alone -- deleting the record takes its dismissals with
  // it, rather than leaving rows nothing can ever match or clean up.
  documentId   String?
  customItemId String?
  todoId       String?
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  customItem   CustomItem? @relation(fields: [customItemId], references: [id], onDelete: Cascade)
  todo         Todo?       @relation(fields: [todoId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([userId, itemKey])
  @@index([documentId])
  @@index([customItemId])
  @@index([todoId])
}

model ActivityEvent {
  id         String   @id
  action     String
  moduleName String
  objectName String
  icon       String
  href       String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  event     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
