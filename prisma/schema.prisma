generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id                  String          @id
  name                String
  type                String
  status              String
  expiryDate          DateTime?
  issueDate           DateTime?
  owner               String          @default("user")
  documentNumber      String?
  country             String?
  notes               String?
  link                String?
  prompt              Int             @default(180)
  expiryDateLabel     String          @default("Expiry date")
  issueDateLabel      String          @default("Issue date")
  documentNumberLabel String          @default("Document number")
  countryLabel        String          @default("Country")
  notesLabel          String          @default("Notes")
  linkLabel           String          @default("Link")
  customFields        DocumentField[]
  notifications       Notification[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

enum NotificationType {
  REMINDER_DUE
  EXPIRED
}

model Notification {
  id              String           @id
  type            NotificationType
  documentId      String
  reminderAt      DateTime?
  timeUntilExpiry String?
  expiryDate      DateTime
  documentName    String
  documentType    String?
  message         String
  actionUrl       String
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, type, expiryDate])
  @@index([createdAt])
}

model DocumentField {
  id         String   @id
  documentId String
  label      String
  value      String
  position   Int      @default(0)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, position])
}
