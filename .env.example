# =============================================================================
# Kinesis Environment Variables
# =============================================================================
# Copy the variables required for your environment into the appropriate
# .env / .env.local / .env.test file.
#
# This is example/guide
# No real credentials in this file
# Do not put real credentials here or make it public 
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Main Kinesis PostgreSQL database.
# Local development typically points to the local Docker PostgreSQL instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"


# -----------------------------------------------------------------------------
# Clerk Authentication
# -----------------------------------------------------------------------------

# Clerk secret key. Server-side only.
CLERK_SECRET_KEY=""

# Clerk publishable key. Safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Clerk user ID of this deployment's admin: the one person who may invite
# others. It doesn't limit who can sign in -- every signed-in Clerk user gets
# their own private account, so the Clerk instance must use Restricted sign-up
# mode (docs/security/clerk-configuration.md). Optional; unset means no admin.
KINESIS_OWNER_CLERK_USER_ID=""

# Enable Clerk Frontend API proxying only for personal production, which uses
# Clerk production keys. Leave unset or false for development and previews.
CLERK_FRONTEND_API_PROXY_ENABLED="false"


# -----------------------------------------------------------------------------
# Web Push (KD-053)
# -----------------------------------------------------------------------------

# VAPID key pair, from `npx web-push generate-vapid-keys`. Use a separate pair
# per database: a device's subscription only works with the key it was made
# against. Never change production's once devices have subscribed.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Contact address the push services can reach the sender at.
VAPID_SUBJECT="mailto:you@example.com"

# Authenticates the daily cron call to /api/cron/push-notifications. Vercel
# sends it automatically as a bearer token. Generate with `openssl rand -hex 32`.
CRON_SECRET=""


# -----------------------------------------------------------------------------
# Integration Testing
# -----------------------------------------------------------------------------

# Dedicated PostgreSQL database used ONLY for integration tests.
# Must never point to the normal Kinesis database.
TEST_DATABASE_URL=""


# -----------------------------------------------------------------------------
# Vercel
# -----------------------------------------------------------------------------

# Normally managed/generated by Vercel rather than manually configured.
VERCEL_OIDC_TOKEN=""
